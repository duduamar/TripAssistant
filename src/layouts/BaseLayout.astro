---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Offline-ready trip guide' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f4e5f" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Trip Guide" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}apple-touch-icon-v2.png`} />
    <link rel="apple-touch-icon-precomposed" sizes="180x180" href={`${baseUrl}apple-touch-icon-v2.png`} />
    <title>{title}</title>
  </head>
  <body>
    <div id="ptr-indicator" aria-hidden="true"><div class="ptr-spinner"></div></div>
    <slot />

    <style>
      #ptr-indicator {
        position: fixed;
        top: env(safe-area-inset-top, 0px);
        left: 0;
        right: 0;
        height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        pointer-events: none;
        z-index: 2000;
      }

      #ptr-indicator .ptr-spinner {
        width: 26px;
        height: 26px;
        margin-top: 10px;
        border-radius: 50%;
        border: 3px solid rgba(31, 78, 95, 0.25);
        border-top-color: #1f4e5f;
        opacity: 0;
      }

      #ptr-indicator.ptr-refreshing .ptr-spinner {
        opacity: 1;
        animation: ptr-spin 0.7s linear infinite;
      }

      @keyframes ptr-spin {
        to {
          transform: rotate(360deg);
        }
      }
    </style>

    <script>
      (() => {
        if (typeof window === 'undefined' || !('ontouchstart' in window)) return;

        const indicator = document.getElementById('ptr-indicator');
        if (!indicator) return;
        const spinner = indicator.querySelector('.ptr-spinner');

        const TRIGGER_HEIGHT = 60; // pull distance (px) needed to trigger a refresh
        const MAX_HEIGHT = 90;
        const RESISTANCE = 0.5;

        let startY = 0;
        let pulling = false;
        let refreshing = false;

        const atTop = () =>
          (window.scrollY || document.documentElement.scrollTop || 0) <= 0;

        const setHeight = (h) => {
          indicator.style.height = `${h}px`;
        };

        const resetIndicator = () => {
          indicator.style.transition = 'height 0.2s ease';
          setHeight(0);
          if (spinner) spinner.style.opacity = '0';
          window.setTimeout(() => {
            indicator.style.transition = 'none';
          }, 220);
        };

        const triggerRefresh = async () => {
          refreshing = true;
          indicator.style.transition = 'height 0.2s ease';
          setHeight(TRIGGER_HEIGHT);
          indicator.classList.add('ptr-refreshing');
          if (spinner) {
            spinner.style.opacity = '1';
            spinner.style.transform = '';
          }

          let reloaded = false;
          const reload = () => {
            if (reloaded) return;
            reloaded = true;
            window.location.reload();
          };

          try {
            const reg = navigator.serviceWorker
              ? await navigator.serviceWorker.getRegistration()
              : null;

            if (reg) {
              navigator.serviceWorker.addEventListener('controllerchange', reload);
              await reg.update();
              if (reg.waiting) {
                reg.waiting.postMessage({ type: 'SKIP_WAITING' });
              }
              // Fall back to a plain reload if no new worker takes control.
              window.setTimeout(reload, 1200);
            } else {
              reload();
            }
          } catch {
            reload();
          }
        };

        window.addEventListener(
          'touchstart',
          (e) => {
            if (refreshing || e.touches.length !== 1) {
              pulling = false;
              return;
            }
            if (atTop()) {
              startY = e.touches[0].clientY;
              pulling = true;
              indicator.style.transition = 'none';
            } else {
              pulling = false;
            }
          },
          { passive: true }
        );

        window.addEventListener(
          'touchmove',
          (e) => {
            if (!pulling || refreshing) return;

            const dy = e.touches[0].clientY - startY;
            if (dy <= 0 || !atTop()) {
              pulling = false;
              setHeight(0);
              if (spinner) spinner.style.opacity = '0';
              return;
            }

            const pull = Math.min(MAX_HEIGHT, dy * RESISTANCE);
            setHeight(pull);
            if (spinner) {
              spinner.style.opacity = String(Math.min(1, pull / TRIGGER_HEIGHT));
              spinner.style.transform = `rotate(${pull * 3}deg)`;
            }
            e.preventDefault();
          },
          { passive: false }
        );

        const endPull = () => {
          if (!pulling || refreshing) return;
          pulling = false;
          const height = parseFloat(indicator.style.height) || 0;
          if (height >= TRIGGER_HEIGHT) {
            triggerRefresh();
          } else {
            resetIndicator();
          }
        };

        window.addEventListener('touchend', endPull);
        window.addEventListener('touchcancel', endPull);
      })();
    </script>
  </body>
</html>
